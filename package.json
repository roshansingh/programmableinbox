{
  "name": "programmableinbox",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev --port 4000",
    "lint": "eslint .",
    "prepare": "git config core.hooksPath .githooks || true",
    "scan:secrets": "gitleaks git --config .gitleaks.toml --log-opts=--all --redact .",
    "backfill:api-keys": "node --import tsx scripts/backfill-api-key-hashes.ts",
    "backfill:org-names": "node --import tsx scripts/backfill-org-names.ts",
    "start": "next start --port 4000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts"
  },
