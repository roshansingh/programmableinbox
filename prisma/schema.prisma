generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  email         String   @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  /// Written by POST /api/app/auth/verification/confirm (issue #102). Gated on
  /// ENABLE_EMAIL_VERIFICATION: with the flag off nothing reads it but the
  /// serializer, which is why the grandfathering backfill is safe to run
  /// unconditionally.
  emailVerified Boolean  @default(false)
  /// Last time a verification email was sent, for the resend cooldown. A
  /// column rather than an in-process map because the app runs as more than
  /// one container: an in-memory throttle is defeated by round-robin across
  /// instances and resets on every deploy. Redis would also work but is
  /// optional in this deployment; one nullable timestamp is not.
  verificationEmailSentAt DateTime? @db.Timestamptz(3)
  /// Set by POST /api/app/auth/password-reset/confirm. A session JWT issued
  /// before this instant is rejected, so completing a reset evicts sessions an
  /// attacker may already hold — which is the point of resetting a password
  /// you believe was compromised. Null means "never reset" and gates nothing,
  /// so existing rows need no backfill.
  passwordChangedAt DateTime? @db.Timestamptz(3)
  /// Last time a password reset email was sent, for the request cooldown.
  /// A column rather than an in-process map for the same reason
  /// verificationEmailSentAt is one: the app runs as more than one container.
  passwordResetEmailSentAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  memberships  Membership[]
  emailInboxes EmailInbox[]
  phoneInboxes PhoneInbox[]
  apiKeys      ApiKey[]
  automationRevisionsCreated AutomationRevision[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships   Membership[]
  emailInboxes  EmailInbox[]
  phoneInboxes  PhoneInbox[]
  apiKeys       ApiKey[]
  webhooks      Webhook[]
  emailMessages EmailMessage[]
  automations   Automation[]
  automationRuns AutomationRun[]
  /// Optional-singular rather than a list: `Subscription.organizationId` is
  /// `@unique`, so one organization has at most one subscription. An org with
  /// no row resolves to the `free` plan, which is what lets the flag be turned
  /// on without backfilling every existing organization first.
  subscription  Subscription?
  usageCounters UsageCounter[]
  /// Stripe's customer handle (issue #120). Null until the organization first
  /// reaches checkout — a free organization never gets one, and a self-hosted
  /// deployment never writes one at all.
  ///
  /// Unique so a double-submitted checkout cannot mint two Stripe customers for
  /// one organization, which would split their invoices and payment methods
  /// across two records nobody can reconcile.
  stripeCustomerId String? @unique

  @@map("organizations")
}

/// Membership roles. Deliberately has no default: an implicit `owner` default
/// meant a membership created without an explicit role silently became an org
/// owner (F6). Callers must now state the role.
enum Role {
  owner
  admin
  member
  viewer
}

model Membership {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  role           Role
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

model EmailInbox {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  /// Globally unique (F1). Inbound routing matches purely on this address, so
  /// two orgs holding the same address means mail lands in both. Uniqueness is
  /// what makes that physically impossible.
  ///
  /// Always stored normalized — lowercased, trimmed, and printable-ASCII only
  /// (see `lib/email-address.ts`). This index is byte-exact while the router
  /// lowercases the inbound recipient, so without normalization
  /// `Billing@corp.com` and `billing@corp.com` would be two rows to Postgres
  /// but one address to the router — and the second claimant would intercept
  /// the first's mail. A CHECK constraint added in
  /// `20260721_normalize_inbox_addresses` (lowercase, no whitespace, ASCII only)
  /// enforces the invariant at the database layer; it is not expressible in
  /// this schema, so it lives only in that migration's SQL.
  ///
  /// Soft-deleted rows keep their address, so a deleted inbox's address can
  /// never be reclaimed by another org. This is deliberately NOT a partial
  /// index on `deleted_at IS NULL`: mail keeps being delivered to the address
  /// after an inbox is deleted, so freeing it for reclaim would hand the next
  /// claimant the previous owner's still-arriving mail.
  email          String   @unique
  name           String?
  deletedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailMessages    EmailMessage[]
  automations      Automation[]
  autoReplyLedgers    AutoReplyLedger[]
  emailJobDeadLetters EmailJobDeadLetter[]

  /// Required as the target of EmailMessage's composite tenant FK (F7).
  /// Redundant for uniqueness (id is already the PK) but Postgres requires a
  /// unique constraint on referenced columns.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("email_inboxes")
}

model PhoneInbox {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  phoneNumber    String
  countryCode    String
  deletedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("phone_inboxes")
}

model ApiKey {
  id             String   @id @default(uuid(7)) @db.Uuid
  /// Legacy plaintext column. Always written as null since the hashing change;
  /// retained only for pre-existing rows. Dropping it is destructive and gated
  /// on verifying prod has no legacy keys (F5, deferred).
  apiKey         String?  @unique
  /// Nullable for the same legacy reason. Should become NOT NULL once legacy
  /// rows are backfilled (F5, deferred).
  keyHash        String?  @unique
  prefix         String?
  name           String
  scopes         String[] @default([])
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  /// Key lifecycle (F5). Auth rejects a key once revoked or past expiry, so a
  /// leaked credential can be killed at the data layer. Deleting a key sets
  /// revokedAt rather than removing the row.
  expiresAt      DateTime? @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  lastUsedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("api_keys")
}

model EmailMessage {
  id                  String   @id @default(uuid(7)) @db.Uuid
  from                String
  to                  String[]
  bcc                 String[]
  cc                  String[]
  subject             String
  text                String
  html                String
  /// Best-effort plain text of the body, for full-text search (issue #106). The
  /// provider's `text` when the sender supplied one, otherwise text extracted
  /// from `html` at write time by lib/email/extract-body-text.ts. `text` keeps
  /// meaning "what the sender sent"; this is what we derived.
  ///
  /// Nullable, and deliberately not backfilled: the generated column below falls
  /// back to `text`, so subject search covers all mail from day one and body
  /// search covers everything that arrived with a text part. Only the bodies of
  /// pre-existing HTML-only mail are missing.
  bodyText            String?
  headers             Json
  /// Resend's opaque email id — an external string, not a row id.
  externalId          String
  inboxEmailAddressId String   @db.Uuid
  organizationId      String   @db.Uuid
  /// Always holds an EmailMessage id: a new thread seeds this with the message's
  /// own id (see the send route), so it is uuid-typed like any other row id.
  threadId            String   @db.Uuid
  parentMessageId     String?  @db.Uuid
  /// RFC-822 Message-ID from the mail headers. Stays text — it is an external
  /// identifier and is not a UUID. Same for inReplyTo / references below.
  messageId           String   @unique
  inReplyTo           String?
  references          String[]
  tags                String[] @default([])
  isStarred           Boolean  @default(false)
  /// Inbox-wide, not per-user (issue #138 v1): one shared flag, like isStarred.
  /// Any org member viewing the inbox can flip it — see MessageReadScope in
  /// lib/services/scope.ts for why that differs from isStarred's owner-only
  /// mutation authority.
  isRead              Boolean  @default(false)
  categories          String[] @default([])
  extractedOtp        String?
  metadata            Json?
  /// Per-step completion markers for the ingestion worker (F19). The worker
  /// gates each step on its own marker rather than on message existence, so a
  /// retry after a mid-processing crash re-runs the steps that didn't finish
  /// instead of skipping them because the message row already exists.
  /// Full-text index over subject (weight A) and body (weight B), maintained by
  /// Postgres as a STORED generated column — see the migration for the
  /// expression. Declared Unsupported so Prisma knows the column exists and
  /// never selects or writes it; `lib/services/message-search.ts` queries it
  /// through raw SQL.
  ///
  /// The `@default(dbgenerated(...))` is not a default — the column has none. It
  /// is the only way to tell Prisma's differ that this column's value is produced
  /// by an expression, and it must match what Postgres reports in
  /// `information_schema` byte for byte. Without it `prisma migrate diff` reports
  /// permanent drift, and the next `prisma migrate dev` offers to "fix" it by
  /// dropping the generation expression — silently turning the search index into a
  /// column nothing ever writes.
  searchVector        Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, \"left\"(COALESCE(subject, ''::text), 10000)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, \"left\"(COALESCE(\"bodyText\", text, ''::text), 100000)), 'B'::\"char\"))"))
  dispatchedAt        DateTime? @db.Timestamptz(3)
  enrichedAt          DateTime? @db.Timestamptz(3)
  deletedAt           DateTime? @db.Timestamptz(3)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  inboxEmailAddress EmailInbox     @relation(fields: [inboxEmailAddressId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentMessage     EmailMessage?  @relation("EmailMessageReplies", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies           EmailMessage[] @relation("EmailMessageReplies")
  automationRuns    AutomationRun[]
  attachments       EmailAttachment[]

  @@unique([externalId, inboxEmailAddressId])
  @@index([inboxEmailAddressId, createdAt, id])
  @@index([inboxEmailAddressId, threadId, createdAt, id])
  @@index([organizationId])
  @@index([threadId])
  @@index([parentMessageId])
  @@index([categories], type: Gin)
  @@index([tags], type: Gin)
  @@index([searchVector], type: Gin)
  /// Threading's subject fallback runs on every inbound email that Message-ID
  /// matching misses, so this scan is on the ingest hot path (F25).
  @@index([inboxEmailAddressId, subject])
  // The OTP read path is served by a partial index — (inboxEmailAddressId,
  // createdAt DESC) WHERE extractedOtp IS NOT NULL — that lives in the migration
  // as raw SQL, since Prisma's schema cannot express a partial index.
  @@map("email_messages")
}

enum WebhookStatus {
  active
  inactive
  failing
}

enum AutomationRunStatus {
  queued
  running
  succeeded
  failed
  partial
  skipped
}

enum WebhookEventStatus {
  pending
  delivered
  failed
}

model Webhook {
  id             String        @id @default(uuid(7)) @db.Uuid
  name           String
  url            String
  events         String[]
  organizationId String        @db.Uuid
  status         WebhookStatus @default(active)
  secret         String?
  lastTriggered  DateTime? @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  webhookEvents WebhookEvent[]

  @@index([organizationId])
  @@map("webhooks")
}

model WebhookEvent {
  id          String             @id @default(uuid(7)) @db.Uuid
  webhookId   String             @db.Uuid
  event       String
  payload     Json
  status      WebhookEventStatus @default(pending)
  attempts    Int                @default(0)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  /// Event list/count views filter by webhook, optionally by status, and sort
  /// newest-first. The table had no indexes at all, not even on the FK (F4).
  @@index([webhookId, createdAt])
  @@index([webhookId, status, createdAt])
  @@map("webhook_events")
}

model Automation {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @db.Uuid
  inboxId          String?  @db.Uuid
  name             String
  description      String?
  isActive         Boolean  @default(true)
  activeRevisionId String?  @unique @db.Uuid
  deletedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inbox           EmailInbox?          @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  activeRevision  AutomationRevision?  @relation("AutomationActiveRevision", fields: [activeRevisionId], references: [id], onDelete: SetNull)
  revisions       AutomationRevision[] @relation("AutomationRevisions")
  runs            AutomationRun[]
  autoReplyLedger AutoReplyLedger[]

  /// Required as the target of AutomationRun's composite tenant FK (F7).
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([inboxId])
  @@map("automations")
}

model AutomationRevision {
  id              String   @id @default(uuid(7)) @db.Uuid
  automationId    String   @db.Uuid
  revision        Int
  schemaVersion   Int
  config          Json
  layout          Json?
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  automation    Automation   @relation("AutomationRevisions", fields: [automationId], references: [id], onDelete: Cascade)
  activeFor     Automation[] @relation("AutomationActiveRevision")
  createdByUser User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  runs          AutomationRun[]

  @@unique([automationId, revision])
  @@index([automationId])
  @@index([createdByUserId])
  @@map("automation_revisions")
}

model AutomationRun {
  id                   String              @id @default(uuid(7)) @db.Uuid
  automationId         String              @db.Uuid
  automationRevisionId String              @db.Uuid
  organizationId       String              @db.Uuid
  emailMessageId       String?             @db.Uuid
  triggerType          String
  status               AutomationRunStatus
  isDryRun             Boolean             @default(false)
  inputSnapshot        Json
  error                Json?
  startedAt            DateTime            @default(now()) @db.Timestamptz(3)
  finishedAt           DateTime? @db.Timestamptz(3)

  automation         Automation         @relation(fields: [automationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  automationRevision AutomationRevision @relation(fields: [automationRevisionId], references: [id], onDelete: Cascade)
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailMessage       EmailMessage?      @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)
  nodeRuns           AutomationNodeRun[]

  @@index([automationId])
  @@index([automationRevisionId])
  @@index([organizationId])
  @@index([emailMessageId])
  @@map("automation_runs")
}

model AutomationNodeRun {
  id             String              @id @default(uuid(7)) @db.Uuid
  runId          String              @db.Uuid
  /// Identifies a node inside the revision's JSON config graph, not a table row.
  /// Stays text.
  configNodeId   String
  configNodeType String
  status         AutomationRunStatus
  branchTaken    String?
  input          Json?
  output         Json?
  error          Json?
  startedAt      DateTime            @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime? @db.Timestamptz(3)

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("automation_node_runs")
}

model EmailJobDeadLetter {
  id                    String   @id @default(uuid(7)) @db.Uuid
  externalId            String   // Resend email ID — external string, stays text
  inboxEmailAddressId   String   @db.Uuid
  inboxEmailAddress     EmailInbox @relation(fields: [inboxEmailAddressId], references: [id], onDelete: Cascade)
  payload               Json     // Full email payload
  error                 String   // Error message from failed processing
  attemptCount          Int      @default(1)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  @@unique([externalId, inboxEmailAddressId])
  @@map("email_job_dead_letter")
}

model EmailAttachment {
  id             String   @id @default(uuid(7)) @db.Uuid
  emailMessageId String   @db.Uuid
  filename       String
  contentType    String?
  sizeBytes      Int?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  emailMessage EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@index([emailMessageId])
  @@map("email_attachments")
}

model AutoReplyLedger {
  id           String   @id @default(uuid(7)) @db.Uuid
  automationId String   @db.Uuid
  inboxId      String   @db.Uuid
  fromEmail    String
  lastSentAt   DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  inbox      EmailInbox  @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@unique([automationId, inboxId, fromEmail])
  @@map("auto_reply_ledgers")
}

/// The one model deliberately left off the UUIDv7 scheme: `jobName` is a natural
/// key, not a generated id. Backup jobs are addressed by name from
/// deploy/backup/scripts/, so a uuid here would break those scripts for no gain.
model BackupStatus {
  jobName       String   @id @map("job_name")
  lastSuccessAt DateTime @map("last_success_at") @db.Timestamptz(3)
  details       Json?

  @@map("backup_status")
}

/// A commercial plan (issue #117). Only read when `USE_COMMERCIAL=true`; a
/// self-hosted deployment resolves every organization to unlimited limits
/// without ever querying this table.
model Plan {
  /// Surrogate key. Never meaningful, never displayed, and never hardcoded in
  /// application code — reference `code` instead. `SmallInt` because the row
  /// count is a closed set of single digits.
  id            Int      @id @default(autoincrement()) @db.SmallInt
  /// Stable machine key: `self_hosted` | `free` | `pro`. The only plan
  /// identifier application code, seeds and tests may reference. Changing it is
  /// a deliberate breaking act, not a rename.
  code          String   @unique
  /// Display name. Free to change at any time — "Pro" to "Business" is a
  /// one-field UPDATE that touches nothing else. Nothing keys off this.
  name          String
  /// Validated on read and on write by `PlanLimitsSchema`
  /// (lib/commercial/plan-limits.ts). Prisma type-checks nothing here, so that
  /// schema is the whole contract. `null` for a limit means unlimited —
  /// `Infinity` does not survive JSON.
  limits        Json
  /// Read by `POST /api/app/billing/checkout` (the price actually charged) and
  /// `GET /api/app/billing/plans` (the price the billing page displays, fetched
  /// live from Stripe). Singular, so it cannot express monthly and annual
  /// prices at once — revisit if that's ever needed.
  stripePriceId String?
  /// False hides a plan from any pricing or plan-picker UI. `self_hosted` is
  /// not selectable on the hosted offering.
  isPublic      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("plans")
}

/// One organization's current plan assignment. Exactly one row per
/// organization, mutable in place — there is no history and no event log yet
/// (issue #117 §9); adding either later is non-destructive.
/// Stripe's subscription lifecycle, narrowed to the states this app acts on.
///
/// `incomplete` / `incomplete_expired` / `unpaid` / `paused` are deliberately
/// absent: the webhook maps them onto the four below rather than widening the
/// enum, so every state has a decided answer to "does this organization get
/// paid limits?" — a state nobody thought about must not be representable.
enum SubscriptionStatus {
  /// Paying, current. Full plan limits.
  active
  /// In a trial Stripe is managing. Treated as `active` for entitlement.
  trialing
  /// A payment failed and Stripe is retrying. **Still entitled** — see the
  /// note on `Subscription.status`.
  past_due
  /// Stripe has given up or the customer cancelled and the period has ended.
  /// Not entitled; the resolver falls back to `free`.
  canceled
}

model Subscription {
  id                 String   @id @default(uuid(7)) @db.Uuid
  organizationId     String   @unique @db.Uuid
  planId             Int      @db.SmallInt
  /// Mirrors Stripe's subscription status (issue #120). Now an enum rather than
  /// a String: the value set follows Stripe's and Stripe has settled it, so the
  /// column can carry the same guarantee as Role / WebhookStatus.
  ///
  /// `past_due` is load-bearing rather than informational — the resolver keeps
  /// serving the paid plan through it, because Stripe retries a failed card for
  /// weeks and dropping a customer to `free` on the first decline would stop
  /// their mail over an expired card.
  status             SubscriptionStatus
  currentPeriodStart DateTime @db.Timestamptz(3)
  currentPeriodEnd   DateTime @db.Timestamptz(3)
  cancelAtPeriodEnd  Boolean  @default(false)
  /// Stripe subscription id. Unread until billing lands; `@unique` so a
  /// redelivered provider webhook is idempotent by constraint rather than by
  /// application logic.
  externalId         String?  @unique
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// No `onDelete`: the default `Restrict` is correct, so a plan with live
  /// subscribers cannot be deleted out from under them.
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([planId])
  @@map("subscriptions")
}

/// Durable per-period usage, and the thing enforcement actually reads.
///
/// Postgres rather than Redis, deliberately: a dropped rate-limiter counter
/// costs one extra request, a dropped quota counter is a billing error. The
/// unique key is what makes check-and-consume a single atomic statement.
model UsageCounter {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  /// A `QuotaMetric` (lib/commercial/interfaces.ts), e.g. `emails.processed`.
  metric         String
  periodStart    DateTime @db.Timestamptz(3)
  periodEnd      DateTime @db.Timestamptz(3)
  value          Int      @default(0)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The atomic-consume key. Also the reason a plan change mid-period starts a
  /// fresh counter: `periodStart` moves from calendar month to subscription
  /// anniversary, so the upsert misses and creates a new row.
  @@unique([organizationId, metric, periodStart])
  @@index([organizationId, periodStart])
  @@map("usage_counters")
}
