# Copy to .env.test and adjust. Integration tests REQUIRE a dedicated test DB
# whose name contains "test" — the harness refuses to run otherwise.
TEST_DATABASE_URL=postgresql://inbox@localhost:5432/inbox_test?schema=public
JWT_SECRET=test-jwt-secret-at-least-16-chars
WEBHOOK_SECRET=test-webhook-secret
AUTOMATION_SWEEPER_SECRET=test-sweeper-secret
HEALTHZ_SECRET=test-healthz-secret
AUTH_RESEND_API_KEY=re_test_placeholder
NEXT_PUBLIC_API_MODE=local
