# Environment for docker-compose.yml (the Community Edition quick start).
#
# Copy to `.env` next to docker-compose.yml — `docker compose` reads it
# automatically. This is a different, smaller file than the root
# .env.example, which is for running the app from source; see
# docs/quickstart-docker.md for the full walkthrough.

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=programmableinbox
POSTGRES_PASSWORD=
POSTGRES_DB=programmableinbox

# --- App: required, no fallback ------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Any string of 8+ characters works to boot locally. Only needs to be the
# real Resend webhook signing secret once you point Resend at this instance.
WEBHOOK_SECRET=

# A placeholder (e.g. "re_placeholder") is enough to boot and explore the
# dashboard. Outbound email (password resets, verification) and real inbound
# mail both need a real Resend API key — see docs/quickstart-docker.md.
AUTH_RESEND_API_KEY=

# Comma-separated domains an inbox may be created at. A domain you don't
# control yet is fine for exploring the UI, but mail will only actually
# arrive for a domain that's verified in Resend with its inbound route
# pointed at this instance's /api/webhooks/email — see
# docs/quickstart-docker.md.
EMAIL_INBOX_DOMAINS=inbox.example.com

# --- App: optional ---------------------------------------------------------
# AUTH_EMAIL_FROM=no-reply@example.com
# AUTH_EMAIL_FROM_NAME=ProgrammableInbox

# --- Compose ----------------------------------------------------------------
# Pin to a specific release instead of the mutable :latest tag, e.g. v0.10.0
# IMAGE_TAG=latest
# Host port to publish the app on
# APP_PORT=4000
