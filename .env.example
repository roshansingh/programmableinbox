# Environment variables — copy to .env and fill in values.
#
# Every variable here is validated by lib/config against a zod schema on first
# read, and the server refuses to start if any of them is malformed (see
# assertConfig in lib/config/assert.ts). Two rules worth knowing:
#
#   * Unset and blank mean the same thing. `FOO=` is "not configured", so an
#     optional variable falls back to its default and a required one reports
#     as missing.
#   * A value that is set but invalid is always rejected, never quietly
#     replaced by a default. A typo'd tuning value stops the server rather
#     than being silently ignored.
#
# Booleans accept true/1/yes/on and false/0/no/off, case-insensitively.
# Anything else is a validation error.

# The `options=-c timezone=UTC` parameter is REQUIRED, not decorative. Prisma
# sends timestamps as naive strings, which Postgres interprets in the session
# timezone before storing them in timestamptz columns. On a machine whose
# Postgres session is not UTC (e.g. a Mac inheriting America/New_York), every
# timestamp is stored shifted by the local offset. Prisma undoes the shift on
# read, so the ORM looks fine while raw SQL sees the wrong instant — which
# silently breaks the grouped-threads cursor pagination. Keep it on every
# connection string, in every environment.
#
# In production this MUST be the least-privileged runtime role (`inboxui_app`):
# SELECT/INSERT/UPDATE/DELETE on the app schema and nothing else — no DDL, no
# superuser. The application never needs more than DML at runtime. A local dev
# database can keep using a superuser; only the deployment is hardened.
# See deploy/README.md §"Database roles" and deploy/runbooks/04-postgres-role-rotation.md.
DATABASE_URL=postgresql://user:password@localhost:5432/inboxui?options=-c%20timezone%3DUTC

# Connection string used ONLY by `prisma migrate deploy` (the one-shot `migrate`
# container in deploy/docker-compose.yml). It points at the schema-owner role
# (`inboxui_migrator`), which is the only role allowed to run DDL. Optional
# locally — Prisma itself only ever reads DATABASE_URL, and the compose service
# copies this over it at start-up. In the deployed stack it is REQUIRED; the
# migrate service refuses to run without it so that migrations can never
# silently fall back to the app role or the superuser.
# MIGRATE_DATABASE_URL=postgresql://inboxui_migrator:password@localhost:5432/inboxui?options=-c%20timezone%3DUTC

# Signing key for session JWTs. REQUIRED — there is no fallback: signToken/
# verifyToken throw if it is unset or empty, so a misconfigured deploy fails
# closed instead of accepting forged tokens.
# Generate one with:  openssl rand -base64 32
# Rotating it invalidates every issued session (all users must log in again).
JWT_SECRET=
AUTH_RESEND_API_KEY=re_xxxxxxxx
# Resend webhook signing secret (Svix). Required for POST /api/webhooks/email;
# copy it from the Resend dashboard. An unset value rejects every webhook with 401.
WEBHOOK_SECRET=
AUTH_EMAIL_FROM=no-reply@example.com
AUTH_EMAIL_FROM_NAME=Inbox

# Comma-separated domains an inbox may be created at. REQUIRED — assertConfig()
# refuses to boot without at least one valid entry, and there is no "allow
# anything" mode.
#
# Every entry MUST be verified in Resend and pointed at POST /api/webhooks/email.
# That is the whole point: mail only ever reaches us for those domains, so an
# inbox anywhere else (foo@gmail.com) is created, listed, and looks live in the
# UI while being unable to receive a single message.
#
# A malformed entry fails the boot naming the offender rather than being dropped
# with a warning — a silently narrowed allowlist shows up much later as "why
# can't anyone create an inbox at our second domain".
#
# The first entry is the default selection in the create dialog. With exactly
# one entry the dialog shows a fixed @domain suffix; with two or more it shows a
# picker. The list is public — it is served to every authenticated client on
# GET /api/app/auth/me — so put nothing sensitive here.
EMAIL_INBOX_DOMAINS=inbox.example.com

# Determines whether the client hits same-origin /api routes (local) or an
# external server (external). Use "local" for development.
NEXT_PUBLIC_API_MODE=local

# Async webhook processing with BullMQ
# Set to true to process incoming Resend emails asynchronously via Redis queue.
# Webhook responses return in 50-100ms instead of blocking on email storage/automation dispatch.
# Requires REDIS_URL to be set and reachable.
# Default: false (synchronous processing, no Redis needed)
ENABLE_ASYNC_WEBHOOK_PROCESSING=false

# Redis connection URL for the async webhook queue/worker and the automation
# replay rate limiter.
# Format: redis://[username:password@]host[:port][/db]  (rediss:// for TLS)
#
# There is NO default. A redis://localhost:6379 fallback used to be built in,
# and it is the wrong shape for this variable: on a host where it was left
# unset, the app silently dialled a Redis that either did not exist — an outage
# that looks like a network fault — or belonged to another service on the same
# box, at which point two deployments quietly shared a queue and a rate limiter.
#
# Required when ENABLE_ASYNC_WEBHOOK_PROCESSING=true; the server refuses to
# start without it. Otherwise optional: leaving it unset means the automation
# replay rate limiter reports "unavailable" and the replay endpoint fails closed.
#
# Example with password: redis://:mypassword@redis.example.com:6379
REDIS_URL=redis://localhost:6379

# Max retries for webhook jobs before moving to dead-letter queue
# Default: 3 (means 1 initial attempt + 3 retries = 4 total attempts)
# Backoff is exponential: 1s, 2s, 4s, 8s...
WEBHOOK_QUEUE_MAX_RETRIES=3

# Max parallel webhook jobs processed by the worker
# Higher values = faster processing but more CPU/memory usage
# Tune based on your hardware and job processing time (typically 1-2 jobs/sec per worker)
# Default: 5
WEBHOOK_QUEUE_WORKER_CONCURRENCY_PER_INBOX=5

# LLM Enrichment (optional)
# LLM_PROVIDER=anthropic         # anthropic | openai | openrouter | ollama
# LLM_API_KEY=your-api-key       # Not required for ollama
# LLM_MODEL=                     # Optional model override
# LLM_BASE_URL=                  # Required for ollama; optional override for openrouter

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Pino log level. One of: trace, debug, info, warn, error, fatal, silent.
# Unset means debug in development and info in production. An unrecognised
# value now fails at boot rather than being warned about and ignored — a
# LOG_LEVEL=warning typo used to mean production quietly kept logging at info.
# LOG_LEVEL=info

# Shared secret for the detailed GET /api/healthz response, sent as the
# x-healthz-secret header. Without it the endpoint still reports overall status
# and database health, but omits backup freshness detail.
# HEALTHZ_SECRET=

# Shared secret for POST /api/cron/sweep-stuck-runs, sent as the
# x-automation-sweeper-secret header. The route returns 500 while it is unset,
# so the cron sweeper is effectively disabled without it.
# AUTOMATION_SWEEPER_SECRET=

# ---------------------------------------------------------------------------
# Outbound request safety (SSRF guard)
# ---------------------------------------------------------------------------

# Comma-separated egress allowlist for tenant-controlled webhook URLs (the
# send_webhook automation action). Entries match exactly, or as a domain suffix
# when written with a leading dot. Unset permits every public host.
# WEBHOOK_EGRESS_ALLOWLIST=hooks.example.com,.partner.io

# Local-development escape hatch letting webhooks target loopback/RFC1918
# addresses, so you can point an automation at http://127.0.0.1:3000/hook.
# Ignored entirely when NODE_ENV=production — the insecure mode must not be
# reachable by flipping one variable on a deployed box.
# WEBHOOK_ALLOW_PRIVATE_NETWORK=false

# ---------------------------------------------------------------------------
# Email verification
# ---------------------------------------------------------------------------

# Require new signups to prove they control the address they typed. Default
# false, which is exactly today's behaviour: signup issues a session and
# `emailVerified` is written by nothing.
#
# When true, signup still returns a token, but every authenticated dashboard
# route except GET /api/app/auth/me and the two verification endpoints returns
# 403 until the address is confirmed — a soft gate, with a "verify your email"
# screen instead of a broken dashboard.
#
# Users that existed before this shipped are grandfathered by the backfill in
# prisma/migrations/*_email_verification, so turning this on does not lock out
# the current userbase. Rollback is setting it back to false.
#
# The two variables below are REQUIRED whenever this is true; the server
# refuses to start without them rather than signing up a user and silently
# failing to mail them.
# ENABLE_EMAIL_VERIFICATION=false

# Signing key for verification links. REQUIRED when verification is enabled,
# and deliberately NOT the same value as JWT_SECRET: a verification token
# travels by email, so it lands in mail provider logs, corporate link scanners
# and browser history. A separate secret means such a token presented as
# `Authorization: Bearer` fails signature verification outright — the RFC 8725
# §2.8 Cross-JWT Confusion class this codebase already removed once.
# Generate one with:  openssl rand -base64 32
# EMAIL_VERIFICATION_SECRET=

# Absolute origin used to build verification links, e.g. https://app.pibx.dev.
# REQUIRED when verification is enabled. Operator configuration rather than the
# request's Host header on purpose: deriving it from the request would let
# anyone who controls Host (or X-Forwarded-Host, behind a proxy that forwards
# it unvalidated) choose the domain in the victim's email.
# APP_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Commercial layer
# ---------------------------------------------------------------------------

# Billing. Default false, which uses the OSS defaults (allow all, no metering).
# ENABLE_BILLING=false
