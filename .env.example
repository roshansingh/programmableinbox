# Environment variables — copy to .env and fill in values.
#
# Every variable here is validated by lib/config against a zod schema on first
# read, and the server refuses to start if any of them is malformed (see
# assertConfig in lib/config/assert.ts). Two rules worth knowing:
#
#   * Unset and blank mean the same thing. `FOO=` is "not configured", so an
#     optional variable falls back to its default and a required one reports
#     as missing.
#   * A value that is set but invalid is always rejected, never quietly
#     replaced by a default. A typo'd tuning value stops the server rather
#     than being silently ignored.
#
# Booleans accept true/1/yes/on and false/0/no/off, case-insensitively.
# Anything else is a validation error.

# The `options=-c timezone=UTC` parameter is REQUIRED, not decorative. Prisma
# sends timestamps as naive strings, which Postgres interprets in the session
# timezone before storing them in timestamptz columns. On a machine whose
# Postgres session is not UTC (e.g. a Mac inheriting America/New_York), every
# timestamp is stored shifted by the local offset. Prisma undoes the shift on
# read, so the ORM looks fine while raw SQL sees the wrong instant — which
# silently breaks the grouped-threads cursor pagination. Keep it on every
# connection string, in every environment.
#
# In production this MUST be the least-privileged runtime role (`inboxui_app`):
# SELECT/INSERT/UPDATE/DELETE on the app schema and nothing else — no DDL, no
# superuser. The application never needs more than DML at runtime. A local dev
# database can keep using a superuser; only the deployment is hardened.
# See deploy/README.md §"Database roles" and deploy/runbooks/04-postgres-role-rotation.md.
DATABASE_URL=postgresql://user:password@localhost:5432/inboxui?options=-c%20timezone%3DUTC

# Connection string used ONLY by `prisma migrate deploy` (the one-shot `migrate`
# container in deploy/docker-compose.yml). It points at the schema-owner role
# (`inboxui_migrator`), which is the only role allowed to run DDL. Optional
# locally — Prisma itself only ever reads DATABASE_URL, and the compose service
# copies this over it at start-up. In the deployed stack it is REQUIRED; the
# migrate service refuses to run without it so that migrations can never
# silently fall back to the app role or the superuser.
# MIGRATE_DATABASE_URL=postgresql://inboxui_migrator:password@localhost:5432/inboxui?options=-c%20timezone%3DUTC

# Signing key for session JWTs. REQUIRED — there is no fallback: signToken/
# verifyToken throw if it is unset or empty, so a misconfigured deploy fails
# closed instead of accepting forged tokens.
# Generate one with:  openssl rand -base64 32
# Rotating it invalidates every issued session (all users must log in again).
JWT_SECRET=
AUTH_RESEND_API_KEY=re_xxxxxxxx
# Resend webhook signing secret (Svix). Required for POST /api/webhooks/email;
# copy it from the Resend dashboard. An unset value rejects every webhook with 401.
WEBHOOK_SECRET=
AUTH_EMAIL_FROM=no-reply@example.com
AUTH_EMAIL_FROM_NAME=Inbox

# Comma-separated domains an inbox may be created at. REQUIRED — assertConfig()
# refuses to boot without at least one valid entry, and there is no "allow
# anything" mode.
#
# Every entry MUST be verified in Resend and pointed at POST /api/webhooks/email.
# That is the whole point: mail only ever reaches us for those domains, so an
# inbox anywhere else (foo@gmail.com) is created, listed, and looks live in the
# UI while being unable to receive a single message.
#
# A malformed entry fails the boot naming the offender rather than being dropped
# with a warning — a silently narrowed allowlist shows up much later as "why
# can't anyone create an inbox at our second domain".
#
# The first entry is the default selection in the create dialog. With exactly
# one entry the dialog shows a fixed @domain suffix; with two or more it shows a
# picker. The list is public — it is served to every authenticated client on
# GET /api/app/auth/me — so put nothing sensitive here.
EMAIL_INBOX_DOMAINS=inbox.example.com

# Determines whether the client hits same-origin /api routes (local) or an
# external server (external). Use "local" for development.
NEXT_PUBLIC_API_MODE=local

# Async webhook processing with BullMQ
# Set to true to process incoming Resend emails asynchronously via Redis queue.
# Webhook responses return in 50-100ms instead of blocking on email storage/automation dispatch.
# Requires REDIS_URL to be set and reachable.
# Default: false (synchronous processing, no Redis needed)
ENABLE_ASYNC_WEBHOOK_PROCESSING=false

# Redis connection URL for the async webhook queue/worker and the automation
# replay rate limiter.
# Format: redis://[username:password@]host[:port][/db]  (rediss:// for TLS)
#
# There is NO default. A redis://localhost:6379 fallback used to be built in,
# and it is the wrong shape for this variable: on a host where it was left
# unset, the app silently dialled a Redis that either did not exist — an outage
# that looks like a network fault — or belonged to another service on the same
# box, at which point two deployments quietly shared a queue and a rate limiter.
#
# Required when ENABLE_ASYNC_WEBHOOK_PROCESSING=true or AUTH_RATE_LIMIT_ENABLED
# is on (the latter is the default); the server refuses to start without it.
# Otherwise optional: leaving it unset means the automation replay rate limiter
# reports "unavailable" and the replay endpoint fails closed.
#
# Example with password: redis://:mypassword@redis.example.com:6379
REDIS_URL=redis://localhost:6379

# Max retries for webhook jobs before moving to dead-letter queue
# Default: 3 (means 1 initial attempt + 3 retries = 4 total attempts)
# Backoff is exponential: 1s, 2s, 4s, 8s...
WEBHOOK_QUEUE_MAX_RETRIES=3

# Max parallel webhook jobs processed by the worker
# Higher values = faster processing but more CPU/memory usage
# Tune based on your hardware and job processing time (typically 1-2 jobs/sec per worker)
# Default: 5
WEBHOOK_QUEUE_WORKER_CONCURRENCY_PER_INBOX=5

# LLM Enrichment (optional)
# LLM_PROVIDER=anthropic         # anthropic | openai | openrouter | ollama
# LLM_API_KEY=your-api-key       # Not required for ollama
# LLM_MODEL=                     # Optional model override
# LLM_BASE_URL=                  # Required for ollama; optional override for openrouter

# ---------------------------------------------------------------------------
# Authentication rate limiting and lockout (issue #42)
# ---------------------------------------------------------------------------

# Master switch for login/registration throttling and account lockout.
# Default: true. When true, REDIS_URL is REQUIRED and the server refuses to
# start without it — an unbacked limiter allows every request and says so only
# in a log line, so "throttling is off" has to be something you chose.
# Set false on a dev box with no Redis.
# AUTH_RATE_LIMIT_ENABLED=true

# Login attempts per client IP. Blunts password spraying from one source.
# Default: 20 per 5 minutes.
# AUTH_RATE_LIMIT_LOGIN_IP_MAX=20
# AUTH_RATE_LIMIT_LOGIN_IP_WINDOW_S=300

# Login attempts per submitted email address. Blunts credential stuffing from
# rotating IPs. Over budget does NOT deny a correct password — the password is
# still checked and a valid one logs in; only wrong ones get 429. Otherwise
# anyone knowing your address could deny you login indefinitely.
# Default: 10 per 15 minutes.
# AUTH_RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
# AUTH_RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_S=900

# Registrations per client IP. Default: 10 per hour.
# AUTH_RATE_LIMIT_REGISTER_IP_MAX=10
# AUTH_RATE_LIMIT_REGISTER_IP_WINDOW_S=3600

# Registrations per submitted address. Default: 5 per hour.
# AUTH_RATE_LIMIT_REGISTER_ACCOUNT_MAX=5
# AUTH_RATE_LIMIT_REGISTER_ACCOUNT_WINDOW_S=3600

# Progressive lockout after N consecutive failed logins for one address.
# Duration doubles per further failure from BASE_S, capped at MAX_S. The cap is
# deliberately modest: lockout is itself a DoS primitive. A correct password
# clears the lock rather than being refused by it.
# FAILURE_WINDOW_S is how long "consecutive" lasts before the counter decays.
# Defaults: 5 failures; 60s doubling to a 900s ceiling; 1h counter TTL.
# AUTH_LOCKOUT_THRESHOLD=5
# AUTH_LOCKOUT_BASE_S=60
# AUTH_LOCKOUT_MAX_S=900
# AUTH_LOCKOUT_FAILURE_WINDOW_S=3600

# Hard ceiling on any single Redis command issued by the limiter. Default: 250.
# RATE_LIMIT_TIMEOUT_MS=250

# What to do when Redis is configured but unreachable AT REQUEST TIME (a
# different question from "unconfigured", which is refused at boot).
#   open   (default) allow, flag the decision degraded, log at ERROR. Brute
#          force is possible for the outage's duration — bounded, detectable,
#          still throttled by bcrypt's cost.
#   closed reject with 429. A Redis outage becomes a full authentication
#          outage, including for the operators who need to log in to fix it.
# RATE_LIMIT_FAIL_MODE=open

# How many reverse proxies append to X-Forwarded-For between the internet and
# this process. Default 1 (Caddy). The client IP is taken as the entry at
# `length - TRUSTED_PROXY_COUNT` — the RIGHTMOST by default, never the leftmost,
# which any caller can forge to mint a fresh budget per request.
# Set 2 if you put a CDN in front of Caddy.
# Set 0 to declare "no trusted proxy": XFF is then ignored and per-IP limiting
# is disabled rather than bucketing every caller into one shared budget.
# TRUSTED_PROXY_COUNT=1

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Pino log level. One of: trace, debug, info, warn, error, fatal, silent.
# Unset means debug in development and info in production. An unrecognised
# value now fails at boot rather than being warned about and ignored — a
# LOG_LEVEL=warning typo used to mean production quietly kept logging at info.
# LOG_LEVEL=info

# Shared secret for the detailed GET /api/healthz response, sent as the
# x-healthz-secret header. Without it the endpoint still reports overall status
# and database health, but omits backup freshness detail.
# HEALTHZ_SECRET=

# Shared secret for POST /api/cron/sweep-stuck-runs, sent as the
# x-automation-sweeper-secret header. The route returns 500 while it is unset,
# so the cron sweeper is effectively disabled without it.
# AUTOMATION_SWEEPER_SECRET=

# ---------------------------------------------------------------------------
# Outbound request safety (SSRF guard)
# ---------------------------------------------------------------------------

# Comma-separated egress allowlist for tenant-controlled webhook URLs (the
# send_webhook automation action). Entries match exactly, or as a domain suffix
# when written with a leading dot. Unset permits every public host.
# WEBHOOK_EGRESS_ALLOWLIST=hooks.example.com,.partner.io

# Local-development escape hatch letting webhooks target loopback/RFC1918
# addresses, so you can point an automation at http://127.0.0.1:3000/hook.
# Ignored entirely when NODE_ENV=production — the insecure mode must not be
# reachable by flipping one variable on a deployed box.
# WEBHOOK_ALLOW_PRIVATE_NETWORK=false

# ---------------------------------------------------------------------------
# Email verification
# ---------------------------------------------------------------------------

# Require new signups to prove they control the address they typed. Default
# false, which is exactly today's behaviour: signup issues a session and
# `emailVerified` is written by nothing.
#
# When true, signup still returns a token, but every authenticated dashboard
# route except GET /api/app/auth/me and the two verification endpoints returns
# 403 until the address is confirmed — a soft gate, with a "verify your email"
# screen instead of a broken dashboard.
#
# Users that existed before this shipped are grandfathered by the backfill in
# prisma/migrations/*_email_verification, so turning this on does not lock out
# the current userbase. Rollback is setting it back to false.
#
# The two variables below are REQUIRED whenever this is true; the server
# refuses to start without them rather than signing up a user and silently
# failing to mail them.
# ENABLE_EMAIL_VERIFICATION=false

# Signing key for every emailed link — verification today, password reset
# next. REQUIRED when verification is enabled, and deliberately NOT the same
# value as JWT_SECRET: an emailed token travels by email, so it lands in mail
# provider logs, corporate link scanners and browser history. A separate
# secret means such a token presented as `Authorization: Bearer` fails
# signature verification outright — the RFC 8725 §2.8 Cross-JWT Confusion
# class this codebase already removed once.
# Generate one with:  openssl rand -base64 32
# EMAIL_LINK_SECRET=

# Absolute origin used to build verification links, e.g. https://app.pibx.dev.
# REQUIRED when verification is enabled. Operator configuration rather than the
# request's Host header on purpose: deriving it from the request would let
# anyone who controls Host (or X-Forwarded-Host, behind a proxy that forwards
# it unvalidated) choose the domain in the victim's email.
# APP_BASE_URL=http://localhost:4000

# How long an emailed link stays valid, in whole minutes. 1 to 10080 (7 days).
# Integers only: "30m" is rejected at boot rather than silently ignored, which
# is what a bare constant would have done.
#
# Two knobs rather than one because the tokens differ in what they grant: a
# verification link flips one boolean, a reset link takes over the account.
# Reset should not outlive verification.
# EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30
# PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Commercial layer
# ---------------------------------------------------------------------------

# Plan enforcement (issue #117). Default false, which is the OSS posture: every
# organization resolves to an unlimited `self_hosted` plan and the plans,
# subscriptions and usage_counters tables are never queried.
#
# Turn on only for the hosted offering, where each organization is assigned a
# plan whose limits gate inbox creation, inbound message processing, outbound
# email and LLM enrichment.
#
# Renamed from ENABLE_BILLING with no alias: a deployment still setting the old
# name fails at boot naming USE_COMMERCIAL rather than starting with
# enforcement silently off.
# USE_COMMERCIAL=false

# Stripe (issue #120). Both are REQUIRED whenever USE_COMMERCIAL=true and are
# asserted at boot — a deployment that enforces plans without them cannot sell
# anything, so it fails loudly rather than 500ing at the payment step.
#
# Both are secret-boxed: they render as [redacted] in logs and are reachable
# only via .reveal(). A live Stripe key in a log line is a full account
# compromise.
#
# Note STRIPE_SECRET_KEY shares its `sk_live_` prefix with this application's
# own API keys (lib/api-key-scopes.ts). See .gitleaks.toml — the scanner
# distinguishes them by shape, not prefix.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
#
# From `stripe listen` in development, or the endpoint's signing secret in the
# Stripe dashboard. Verifies that a webhook really came from Stripe.
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# MCP server (issue #104)
# ---------------------------------------------------------------------------

# Exposes the read-only email surface over MCP at POST /api/mcp, authenticated
# with an existing sk_live_ API key. Default false; while off the route 404s.
# ENABLE_MCP=false

# Comma-separated browser origins allowed to call /api/mcp. Empty by default,
# which rejects any request carrying an Origin header at all — the DNS-rebinding
# defense the MCP transport spec requires. Every supported client (Claude Code,
# Cursor, VS Code, claude.ai) is a server-side or native caller that sends no
# Origin, so leave this unset unless a browser app genuinely needs the endpoint.
# Each entry must be a full origin including the scheme (https://app.example.com,
# not app.example.com). A value that is not one fails assertConfig() at boot,
# rather than being dropped and silently refusing the requests it was meant to
# admit.
# MCP_ALLOWED_ORIGINS=https://app.example.com

# Per-API-key request budget for /api/mcp. Shares the limiter in
# lib/security/rate-limit.ts under the "mcp" scope, so it is subject to
# AUTH_RATE_LIMIT_ENABLED and needs REDIS_URL when that is on.
# MCP_RATE_LIMIT_MAX=120
# MCP_RATE_LIMIT_WINDOW_S=60

# ---------------------------------------------------------------------------
# Observability: log search & tracing (EE)
# ---------------------------------------------------------------------------

# Ships traces (pushed by the app over OTLP) and logs (tailed from this
# host's Docker stdout files) through a local `otel-collector` container —
# see deploy/otel-collector.yaml — to whatever OTLP-compatible backend the
# collector is pointed at below. EE/SaaS only: this flag is inert on a
# Community Edition build, since the code that reads it (ee/observability/)
# does not exist there. Default false. See docs/observability-operator-guide.md.
# ENABLE_OBSERVABILITY=false

# Standard OpenTelemetry SDK environment variables read directly by
# @vercel/otel. REQUIRED whenever ENABLE_OBSERVABILITY=true and asserted at
# boot. Point these at the otel-collector service on the internal docker
# network, NOT at your OTLP backend directly — the collector is the thing
# that holds the real backend credentials (below). OTEL_EXPORTER_OTLP_HEADERS
# carries no real secret here; it's still required because assertConfig()
# doesn't know the endpoint is a same-host collector rather than a public
# OTLP gateway — any non-empty value satisfies it.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=X-Local-Collector=unused

# Service name reported to the OTel backend. Defaults to "inboxui".
# OTEL_SERVICE_NAME=inboxui

# ---------------------------------------------------------------------------
# Product analytics (EE)
# ---------------------------------------------------------------------------

# PostHog instrumentation (issue #152): session replay, autocapture,
# error tracking, and named feature/conversion events. EE/SaaS only: this
# flag is inert on a Community Edition build, since the code that reads it
# (ee/product-analytics/) does not exist there. Not tied to USE_COMMERCIAL —
# a self-hosted EE deployment without Stripe billing should still be able to
# enable it. Default false.
# ENABLE_PRODUCT_ANALYTICS=false

# PostHog project API key (phc_...). REQUIRED whenever
# ENABLE_PRODUCT_ANALYTICS=true and asserted at boot. This is PostHog's
# public, write-only project key by their own design — safe to ship to the
# browser (it reaches the client via GET /api/app/auth/me, not a
# NEXT_PUBLIC_* var). Never set the separate Personal API Key (phx_...) here;
# that one is admin-scoped and read-capable, and this app never uses it.
# POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostHog ingestion host. REQUIRED whenever ENABLE_PRODUCT_ANALYTICS=true.
# Use the EU region (https://eu.i.posthog.com) if GDPR posture requires no US
# data transfer; IP capture is off by default there.
# POSTHOG_HOST=https://us.i.posthog.com

# The otel-collector container's own credentials for the real OTLP backend
# (deploy/otel-collector.yaml) — this is where the actual endpoint/auth for
# Grafana Cloud or any other OTLP-compatible backend goes. Not read by the
# app; only meaningful once ENABLE_OBSERVABILITY=true and the `observability`
# compose profile is started (deploy/README.md Part 9). In deploy/, these
# live in their own /srv/inboxui/secrets/otel-collector.env, deliberately
# separate from app.env — see that file's env_file comment for why.
# OTEL_EXPORTER_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
# OTEL_EXPORTER_AUTH=Basic <base64 of instanceID:apiToken>
